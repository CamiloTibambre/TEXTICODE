[
  {
    "id": "02-entorno",
    "titulo": "Versiones y rama activa",
    "pasos": [
      {
        "carpeta": ".",
        "comando": "node --version"
      },
      {
        "carpeta": ".",
        "comando": "npm.cmd --version"
      },
      {
        "carpeta": ".",
        "comando": "git branch --show-current"
      }
    ]
  },
  {
    "id": "03-archivos",
    "titulo": "Archivos de pruebas por modulo",
    "pasos": [
      {
        "carpeta": ".",
        "comando": "dir /s /b BACKEND\\__tests__ FRONTEND\\tests"
      }
    ]
  },
  {
    "id": "04-backend-instalado",
    "titulo": "Dependencias de pruebas del BACKEND",
    "pasos": [
      {
        "carpeta": "BACKEND",
        "comando": "npm.cmd ls jest supertest --depth=0"
      }
    ]
  },
  {
    "id": "05-frontend-instalado",
    "titulo": "Dependencias de pruebas del FRONTEND",
    "pasos": [
      {
        "carpeta": "FRONTEND",
        "comando": "npm.cmd ls jest jest-environment-jsdom @vue/test-utils @vue/vue3-jest babel-jest @babel/core @babel/preset-env --depth=0"
      }
    ]
  },
  {
    "id": "06-configuracion",
    "titulo": "Configuracion de Jest",
    "pasos": [
      {
        "carpeta": ".",
        "comando": "type BACKEND\\jest.config.js"
      },
      {
        "carpeta": ".",
        "comando": "type FRONTEND\\jest.config.cjs"
      }
    ]
  },
